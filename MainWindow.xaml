<Window x:Class="MyWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyWpfApp"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <TextBlock FontWeight="Bold">Состав изделия
        <LineBreak/></TextBlock>

        <StackPanel Grid.Column="0">
            <Button
                Content="Импорт папки..."
                FontSize="13"
                Width="120"
                Height="30"
                Background="#25B1F3"
                BorderThickness="0"
                Click="Button_Click"
                Margin="0, 20, 0, 0"
                Padding="10,5,10,5"/>
            <!-- <Button.Template>
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template> -->

            <ListBox x:Name="MyList"
                     SelectionChanged="MyListSelectionChanged"
                     Height="300"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <ListBox x:Name="MyListRight"
                     Height="450"/>
            <!-- <ComboBox x:Name="MyComboBox">
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Утверждено"/>
                <ComboBoxItem Content="Аннулировано"/>
            </ComboBox> -->
        </StackPanel>
        <StackPanel Grid.Column="2">
            <WebBrowser x:Name="MyBrowser"
                        Height="600"/>
        </StackPanel>

        <Button x:Name="ApproveButton"
                Grid.Column="1"
                Content="Утвердить"
                Width="100"
                Height="25"
                Margin="0, 0, 250, 0"
                Click="Approve_Button"/>
        <Button x:Name="CancelButton"
                Grid.Column="1"
                Content="Аннулировать"
                Width="100"
                Height="25"
                Click="Cancel_Button"/>
    </Grid>
</Window>
